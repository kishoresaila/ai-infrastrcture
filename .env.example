# Copy to .env  (cp .env.example .env). docker compose reads it automatically.

# Chat model. Alternatives: llama3.1:8b, qwen3:4b or llama3.2:3b for low-RAM machines
LLM_MODEL=qwen3:8b

# Embedding model (768 dimensions)
EMBED_MODEL=nomic-embed-text

# How many document chunks to give the LLM per question
TOP_K=5
